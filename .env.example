# ============================================================
# Frontend (Vite). Variables de build del cliente.
# ============================================================

# URL base de la API (backend separado del frontend).
# Vacío = misma ruta "/api" del origen actual:
#   - en desarrollo, el proxy de Vite la reenvía a http://127.0.0.1:8787
#   - en producción, sirve si la API está en el mismo dominio (proxy inverso)
# Rellénala si la API vive en otro dominio, p. ej. https://api.midominio.com
VITE_API_URL=

# Destino del proxy de /api en el servidor de desarrollo de Vite.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# URL del servicio SENIAT legado (compatibilidad; tiene prioridad inferior a VITE_API_URL).
VITE_SENIAT_WORKER_URL=
