# Cadena de conexión a PostgreSQL (cache compartida de RIF).
# En desarrollo/local usa la de tu máquina; en producción, la de tu propio dominio/servidor.
DATABASE_URL=postgres://dualledger:dualledger@localhost:5432/dualledger

# URL del servicio SENIAT (opcional).
# Vacía = se usa el proxy local embebido en el frontend (ruta /api).
