# ============================================================
# API (server/). Es un servicio independiente del frontend.
# Estas variables tienen prioridad sobre las del .env de la raiz.
# ============================================================

# Puerto de escucha de la API
PORT=8787

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://dualledger:dualledger@localhost:5432/dualledger

# Orígenes permitidos por CORS, separados por coma. Vacío = "*" (cualquiera).
# Ejemplo: CORS_ORIGIN=https://app.midominio.com
CORS_ORIGIN=

# Serve el build del frontend (dist/) desde la API.
# Déjalo en 0 si el frontend se despliega por separado (recomendado).
SERVE_STATIC=0
